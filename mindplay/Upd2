/*
  MindPlay — Design tokens
  Paleta: fondo "porcelana" frío (no crema) + acento "iris" (violeta-índigo, mente/introspección)
  y "ámbar" como acento secundario reservado a datos/estadísticas.
  Tipografía: Fraunces (display, con carácter) + Inter (UI/cuerpo) + IBM Plex Mono (datos).
*/

:root {
  /* Color */
  --ink: #15151a;
  --ink-soft: #2b2b34;
  --porcelain: #f4f3f6;
  --surface: #ffffff;
  --surface-sunken: #ecebf1;
  --iris: #7c6cf0;
  --iris-strong: #5f4de0;
  --iris-tint: #efecff;
  --amber: #e8a33d;
  --amber-tint: #fdf1de;
  --muted: #8a8a99;
  --muted-soft: #b5b4c0;
  --border: #e6e5ec;
  --border-strong: #d3d1dc;
  --danger: #e0594f;
  --success: #3fae76;

  /* Tipografía */
  --font-display: "Fraunces", Georgia, serif;
  --font-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, monospace;

  /* Escala tipográfica (mobile-first) */
  --fs-xs: 0.75rem;
  --fs-sm: 0.875rem;
  --fs-base: 1rem;
  --fs-md: 1.125rem;
  --fs-lg: 1.375rem;
  --fs-xl: 1.75rem;
  --fs-2xl: 2.25rem;
  --fs-3xl: 2.75rem;

  /* Espaciado */
  --sp-1: 4px;
  --sp-2: 8px;
  --sp-3: 12px;
  --sp-4: 16px;
  --sp-5: 20px;
  --sp-6: 24px;
  --sp-7: 32px;
  --sp-8: 40px;
  --sp-9: 56px;
  --sp-10: 72px;

  /* Radios y sombras */
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-pill: 999px;
  --shadow-card: 0 1px 2px rgba(21, 21, 26, 0.04), 0 8px 24px rgba(21, 21, 26, 0.06);
  --shadow-float: 0 12px 32px rgba(21, 21, 26, 0.14);

  /* Layout */
  --header-h: 60px;
  --bottomnav-h: 68px;
  --max-w: 720px;

  /* Movimiento */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --dur-fast: 140ms;
  --dur-base: 220ms;
  --dur-slow: 380ms;
}

@media (prefers-color-scheme: dark) {
  /* Reservado: MindPlay usa modo claro único por ahora para mantener consistencia premium */
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--porcelain);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: var(--fs-base);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* Evita cualquier desbordamiento horizontal accidental en móvil */
#root {
  overflow-x: hidden;
  min-height: 100vh;
}

img,
svg {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
  cursor: pointer;
}

h1,
h2,
h3,
h4 {
  font-family: var(--font-display);
  font-weight: 600;
  line-height: 1.15;
  margin: 0;
  letter-spacing: -0.01em;
}

p {
  margin: 0;
}

ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

/* Foco visible siempre — accesibilidad de teclado */
:focus-visible {
  outline: 2px solid var(--iris);
  outline-offset: 3px;
  border-radius: var(--radius-sm);
}

/* Respeta reduce-motion */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

.container {
  width: 100%;
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--sp-5);
}

.eyebrow {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--iris-strong);
  font-weight: 500;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.game-shell {
  padding-top: var(--sp-5);
}

.game-shell__intro {
  text-align: center;
  padding: var(--sp-8) 0;
}

.game-shell__title {
  font-size: var(--fs-2xl);
  margin-bottom: var(--sp-4);
}

.game-shell__instructions {
  color: var(--muted);
  font-size: var(--fs-md);
  max-width: 420px;
  margin: 0 auto var(--sp-7);
}

.game-shell__stage {
  min-height: 320px;
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-6);
  text-align: center;
  gap: var(--sp-4);
}

.game-shell__hud {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--sp-4);
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  color: var(--muted);
}

.reaction-pad {
  width: 100%;
  max-width: 280px;
  height: 220px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: var(--fs-lg);
  font-weight: 600;
  color: #fff;
  transition: background var(--dur-fast) linear;
  user-select: none;
}

.reaction-pad--wait {
  background: var(--ink-soft);
}

.reaction-pad--go {
  background: var(--success);
}

.reaction-pad--early {
  background: var(--danger);
}

.game-result {
  text-align: center;
  padding: var(--sp-7) 0;
}

.game-result__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-2);
  background: var(--amber-tint);
  color: #8a5b12;
  border-radius: var(--radius-pill);
  padding: var(--sp-2) var(--sp-4);
  font-size: var(--fs-sm);
  font-weight: 700;
}

.game-result__score {
  font-family: var(--font-mono);
  font-size: var(--fs-3xl);
  color: var(--iris-strong);
  margin: var(--sp-4) 0;
}

.game-result__label {
  color: var(--muted);
  font-size: var(--fs-sm);
}

.game-result__record {
  margin-top: var(--sp-2);
  font-size: var(--fs-xs);
  color: var(--muted-soft);
  font-family: var(--font-mono);
}

.game-result__ad {
  margin-top: var(--sp-6);
}

.game-result__actions {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  margin-top: var(--sp-7);
}

@media (min-width: 480px) {
  .game-result__actions {
    flex-direction: row;
    justify-content: center;
  }
}

.quiz {
  padding-top: var(--sp-5);
}

.quiz__head {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  margin-bottom: var(--sp-7);
}

.quiz__back {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.quiz__progress-wrap {
  flex: 1;
}

.quiz__step {
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: var(--muted);
  margin-bottom: var(--sp-2);
}

.question-card {
  margin-bottom: var(--sp-7);
}

.question-card__text {
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  font-weight: 600;
  margin-bottom: var(--sp-6);
}

.question-card__options {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

.option-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-4);
  width: 100%;
  min-height: 60px;
  padding: var(--sp-4) var(--sp-5);
  border-radius: var(--radius-md);
  background: var(--surface);
  border: 1.5px solid var(--border);
  text-align: left;
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--ink);
  transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
}

.option-btn:hover {
  border-color: var(--iris);
}

.option-btn:active {
  transform: scale(0.98);
}

.option-btn.selected {
  border-color: var(--iris);
  background: var(--iris-tint);
  color: var(--iris-strong);
}

.option-btn__dot {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid var(--border-strong);
  flex-shrink: 0;
}

.option-btn.selected .option-btn__dot {
  border-color: var(--iris);
  background: var(--iris);
}

/* ---------- Result ---------- */
.result-hero {
  text-align: center;
  padding: var(--sp-8) 0 var(--sp-6);
}

.result-hero__emoji {
  font-size: 3.25rem;
  line-height: 1;
  margin-bottom: var(--sp-3);
}

.result-hero__eyebrow {
  margin-bottom: var(--sp-3);
}

.result-hero__title {
  font-size: var(--fs-3xl);
  line-height: 1.05;
  margin-bottom: var(--sp-3);
}

.result-hero__tagline {
  font-family: var(--font-display);
  font-style: italic;
  font-size: var(--fs-md);
  color: var(--iris-strong);
  max-width: 440px;
  margin: 0 auto;
}

.result-hero__ring {
  display: flex;
  justify-content: center;
  margin: var(--sp-6) 0;
}

.result-hero__description {
  color: var(--muted);
  font-size: var(--fs-md);
  max-width: 480px;
  margin: 0 auto var(--sp-6);
}

/* Bloques de contenido del resultado: fortalezas, "lo que te define",
   lado menos bueno, películas... cada uno entra con AnimatedSection. */
.result-block {
  text-align: left;
  margin: var(--sp-7) 0;
}

.result-block__title {
  font-family: var(--font-display);
  font-size: var(--fs-lg);
  margin-bottom: var(--sp-3);
}

.result-block__hint {
  font-size: var(--fs-sm);
  color: var(--muted);
  font-style: italic;
  margin-bottom: var(--sp-3);
}

.result-traits__list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.result-traits__list li {
  position: relative;
  padding-left: var(--sp-5);
  font-size: var(--fs-sm);
  line-height: 1.5;
}

.result-traits__list--positive li::before {
  content: "+";
  position: absolute;
  left: 0;
  color: var(--success);
  font-weight: 700;
}

.result-traits__list--caution li::before {
  content: "–";
  position: absolute;
  left: 0;
  color: var(--amber);
  font-weight: 700;
}

.result-sections {
  display: flex;
  flex-direction: column;
  gap: var(--sp-5);
}

.result-section__heading {
  font-family: var(--font-display);
  font-size: var(--fs-md);
  margin-bottom: var(--sp-2);
}

.result-section__text {
  color: var(--muted);
  font-size: var(--fs-sm);
  line-height: 1.6;
}

.result-movie-list {
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.result-movie-list li {
  font-size: var(--fs-sm);
  padding: var(--sp-2) 0;
  border-bottom: 1px solid var(--border);
}

.result-disclaimer {
  font-size: var(--fs-xs);
  color: var(--muted-soft);
  margin-top: var(--sp-6);
  font-style: italic;
}

/* Frase final memorable — pull-quote destacado, pensado para el pantallazo. */
.result-quote {
  background: var(--iris-tint);
  border-radius: var(--radius-lg);
  padding: var(--sp-7) var(--sp-6);
  margin: var(--sp-7) 0;
}

.result-quote__text {
  font-family: var(--font-display);
  font-style: italic;
  font-size: var(--fs-lg);
  line-height: 1.35;
  color: var(--iris-strong);
  text-align: center;
}

.result-stats {
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
  margin: var(--sp-7) 0;
}

.result-stat {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.result-stat__row {
  display: flex;
  justify-content: space-between;
  font-size: var(--fs-sm);
  font-weight: 600;
}

.result-stat__value {
  font-family: var(--font-mono);
  color: var(--iris-strong);
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  margin: var(--sp-7) 0;
}

@media (min-width: 480px) {
  .result-actions {
    flex-direction: row;
    justify-content: center;
  }
}

.result-cta {
  background: var(--ink);
  color: #fff;
  border-radius: var(--radius-lg);
  padding: var(--sp-6);
  text-align: center;
  margin: var(--sp-8) 0;
}

.result-cta__title {
  font-family: var(--font-display);
  font-size: var(--fs-lg);
  margin-bottom: var(--sp-4);
}

/* Fila secundaria bajo los botones principales: copiar enlace + feedback. */
.result-copy-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-3);
  margin-top: calc(var(--sp-3) * -1);
  margin-bottom: var(--sp-7);
  text-align: center;
}

.result-copy-feedback {
  font-size: var(--fs-sm);
  color: var(--success);
  font-weight: 600;
}

/* CTA de retención: repetir el mismo test. */
.restart-cta {
  text-align: center;
  border: 1.5px dashed var(--border-strong);
  border-radius: var(--radius-lg);
  padding: var(--sp-6);
  margin: var(--sp-7) 0;
}

.restart-cta__text {
  font-family: var(--font-display);
  font-size: var(--fs-md);
  margin-bottom: var(--sp-4);
}

/* ---------- Header ---------- */
.site-header {
  position: sticky;
  top: 0;
  z-index: 40;
  height: var(--header-h);
  display: flex;
  align-items: center;
  background: rgba(244, 243, 246, 0.86);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}

.site-header__inner {
  width: 100%;
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--sp-5);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-family: var(--font-display);
  font-weight: 600;
  font-size: var(--fs-md);
  color: var(--ink);
}

.brand__mark {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 2.5px solid var(--iris);
  position: relative;
  flex-shrink: 0;
}

.brand__mark::after {
  content: "";
  position: absolute;
  inset: 6px;
  border-radius: 50%;
  background: var(--iris);
}

/* Nav de escritorio, oculta en móvil */
.site-header__nav {
  display: none;
}

@media (min-width: 720px) {
  .site-header__nav {
    display: flex;
    gap: var(--sp-6);
  }

  .site-header__nav a {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-header__nav a.active,
  .site-header__nav a:hover {
    color: var(--ink);
  }
}

/* ---------- BottomNav (mobile-first, navegación a una mano) ---------- */
.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  height: var(--bottomnav-h);
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(14px);
  border-top: 1px solid var(--border);
  display: flex;
}

.bottom-nav__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  min-height: 48px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
  transition: color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
}

.bottom-nav__item svg {
  width: 22px;
  height: 22px;
}

.bottom-nav__item.active {
  color: var(--iris-strong);
}

.bottom-nav__item:active {
  transform: scale(0.92);
}

@media (min-width: 720px) {
  .bottom-nav {
    display: none;
  }
}

/* ---------- PageContainer ---------- */
.page {
  min-height: calc(100vh - var(--header-h));
  padding-bottom: calc(var(--bottomnav-h) + var(--sp-8));
}

@media (min-width: 720px) {
  .page {
    padding-bottom: var(--sp-9);
  }
}

/* ---------- Footer ---------- */
.site-footer {
  display: none;
}

@media (min-width: 720px) {
  .site-footer {
    display: block;
    border-top: 1px solid var(--border);
    padding: var(--sp-7) 0 var(--sp-9);
    margin-top: var(--sp-9);
  }

  .site-footer__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--sp-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .site-footer__links {
    display: flex;
    gap: var(--sp-5);
  }
}

.section-title {
  font-size: var(--fs-lg);
  margin: var(--sp-8) 0 var(--sp-4);
}

.section-title:first-child {
  margin-top: var(--sp-6);
}

/* ---------- Hero ---------- */
.hero {
  padding: var(--sp-8) 0 var(--sp-6);
}

.hero__eyebrow {
  margin-bottom: var(--sp-4);
}

.hero__title {
  font-size: var(--fs-3xl);
  margin-bottom: var(--sp-4);
}

.hero__title em {
  font-style: normal;
  color: var(--iris-strong);
}

.hero__subtitle {
  color: var(--muted);
  font-size: var(--fs-md);
  max-width: 460px;
  margin-bottom: var(--sp-7);
}

.hero__actions {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}

@media (min-width: 480px) {
  .hero__actions {
    flex-direction: row;
  }
}

.hero__stat-row {
  display: flex;
  gap: var(--sp-6);
  margin-top: var(--sp-8);
}

.hero__stat-number {
  font-family: var(--font-mono);
  font-size: var(--fs-xl);
  color: var(--ink);
}

.hero__stat-label {
  font-size: var(--fs-xs);
  color: var(--muted);
}

/* ---------- Test destacado (Home) ---------- */
.featured-test {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--sp-4);
  background: linear-gradient(135deg, var(--iris-tint), var(--amber-tint));
  border-radius: var(--radius-lg);
  padding: var(--sp-6);
  margin-bottom: var(--sp-5);
}

.featured-test__icon {
  font-size: 2.5rem;
  line-height: 1;
}

.featured-test__title {
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  margin-bottom: var(--sp-2);
}

.featured-test__description {
  color: var(--ink);
  opacity: 0.85;
  font-size: var(--fs-sm);
  margin-bottom: var(--sp-4);
  max-width: 460px;
}

@media (min-width: 560px) {
  .featured-test {
    flex-direction: row;
    align-items: center;
  }

  .featured-test__body {
    flex: 1;
  }
}

.home-upcoming-grid {
  margin-top: var(--sp-2);
}

/* ---------- Listados (Tests / Juegos) ---------- */
.list-page__head {
  padding: var(--sp-6) 0 var(--sp-3);
}

.list-page__title {
  font-size: var(--fs-2xl);
  margin-bottom: var(--sp-2);
}

.list-page__subtitle {
  color: var(--muted);
}

.list-page__grid {
  margin-top: var(--sp-5);
}

/* ---------- Detalle (intro antes de empezar) ---------- */
.detail-intro {
  text-align: center;
  padding: var(--sp-9) 0 var(--sp-6);
}

.detail-intro__icon {
  font-size: 2.75rem;
  margin-bottom: var(--sp-4);
}

.detail-intro__title {
  font-size: var(--fs-2xl);
  margin-bottom: var(--sp-4);
}

.detail-intro__text {
  color: var(--muted);
  font-size: var(--fs-md);
  max-width: 440px;
  margin: 0 auto var(--sp-7);
}

/* ---------- CTA de continuidad ---------- */
.continue-cta {
  background: var(--ink);
  color: #fff;
  border-radius: var(--radius-lg);
  padding: var(--sp-7) var(--sp-6);
  text-align: center;
  margin: var(--sp-8) 0;
}

.continue-cta__title {
  font-family: var(--font-display);
  font-size: var(--fs-lg);
  margin-bottom: var(--sp-5);
}

.ad-section {
  margin: var(--sp-8) 0;
}

/* ---------- Recomendaciones ---------- */
.recommendations {
  margin-top: var(--sp-8);
}

/* ---------- Not found ---------- */
.not-found {
  text-align: center;
  padding: var(--sp-10) 0;
}

.not-found__title {
  font-size: var(--fs-2xl);
  margin-bottom: var(--sp-4);
}

/* ---------- Placeholder "Pareja" (sección aún sin contenido) ---------- */
.placeholder-page {
  text-align: center;
  padding: var(--sp-10) var(--sp-4);
}

.placeholder-page__title {
  font-size: var(--fs-2xl);
  margin-bottom: var(--sp-3);
}

.placeholder-page__text {
  color: var(--muted);
  max-width: 380px;
  margin: 0 auto;
}
